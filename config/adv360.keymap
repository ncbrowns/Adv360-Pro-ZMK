#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmli: hrmli {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        hrmri: hrmri {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMRI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        thumblayer: thumblayer {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMBLAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            retro-tap;
            flavor = "balanced";
        };

        td_playpause: td_playpause {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLAYPAUSE";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY_PAUSE>, <&kp LS(C_PLAY_PAUSE)>;
        };

        td_shift: td_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&tog 2>;
        };

        cw_hold_tap: cw_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CW_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };

        cw_minus: cw_minus {
            compatible = "zmk,behavior-hold-tap";
            label = "CW_MINUS";
            bindings = <&cw_exitkey>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };

        nav_alttab: nav_alttab {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_ALTTAB";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&at_enter>, <&kp>;
        };

        hrmli_layer: hrmli_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLI_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmri_layer: hrmri_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMRI_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        cw_bs: cw_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "CW_BS";
            bindings = <&cw_exitlayer>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <2500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            retro-tap;
        };

        toggle_off: toggle_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGGLE_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        toggle_on: toggle_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGGLE_ON";
            #binding-cells = <1>;
        };

        td_cw_shift: td_cw_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CW_SHIFT";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&tog 2>;
        };

        cw_exitkeyorlayer: cw_exitkeyorlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "CW_EXITKEYORLAYER";
            bindings = <&cw_exitlayer>, <&cw_exitkey>;

            #binding-cells = <2>;
            tapping-term-ms = <2500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            retro-tap;
        };
    };

    macros {
        thanks_pat: thanks_pat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap_time 2>,
                <&kp LS(T) &kp H &kp A &kp N &kp K &kp S &kp COMMA &kp LS(RET) &kp LS(P) &kp A &kp T>;

            label = "THANKS_PAT";
        };

        triple_bquote: triple_bquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap_time 2>, <&kp GRAVE &kp GRAVE &kp GRAVE>;

            label = "TRIPLE_BQUOTE";
        };

        browser_copy_url: browser_copy_url {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(D) &kp LC(C) &kp ESC &kp TAB>;
            label = "BROWSER_COPY_URL";
        };

        cw_exitkey: cw_exitkey {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&toggle_off 2 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "CW_EXITKEY";
        };

        ctrl_shift_tab: ctrl_shift_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_wait_time 3>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&macro_wait_time 3>,
                <&kp LSHFT &kp LCTRL>;

            label = "CTRL_SHIFT_TAB";
        };

        at_enter: at_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&toggle_on 8>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_tap>,
                <&toggle_off 8>;

            label = "AT_ENTER";
        };

        cw_exitlayer: cw_exitlayer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&toggle_off 2>;

            label = "CW_EXITLAYER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1        &kp N2        &kp N3         &kp N4           &kp N5  &mo 7                                                                                        &mo 7          &kp N6  &kp N7           &kp N8         &kp N9             &kp N0                &kp MINUS
&kp TAB    &kp Q         &kp W         &kp E          &kp R            &kp T   &none                                                                                        &none          &kp Y   &kp U            &kp I          &kp O              &kp P                 &kp BSLH
&kp ESC    &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &hrmli LSHIFT F  &kp G   &kp C_MUTE               &tog 9                &kp LALT      &kp LGUI   &kp RCTRL            &td_playpause  &kp H   &hrmri RSHIFT J  &hrmr RCTRL K  &hrmr RIGHT_ALT L  &hrmr RGUI SEMICOLON  &kp SQT
&td_shift  &kp Z         &kp X         &kp C          &kp V            &kp B                                                  &kp HOME      &kp PG_UP                                      &kp N   &kp M            &kp COMMA      &kp DOT            &kp FSLH              &td_shift
&none      &kp GRAVE     &kp CAPS      &kp LEFT       &kp RIGHT                &thumblayer 4 BACKSPACE  &thumblayer 5 DELETE  &kp END       &kp PG_DN  &thumblayer 6 ENTER  &kp SPACE              &kp UP           &kp DOWN       &kp LBKT           &kp RBKT              &none
            >;
        };

        Typing {
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans  &trans                                              &trans     &trans  &trans  &trans  &trans  &trans    &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans                                              &trans     &trans  &trans  &trans  &trans  &trans    &trans
&trans     &kp A   &kp S   &kp D   &kp F   &trans  &trans    &kp LCTRL  &trans      &trans  &trans     &trans     &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans                       &trans      &trans                        &trans  &trans  &trans  &trans  &trans    &kp RSHFT
&trans     &trans  &trans  &trans  &trans          &kp BSPC  &kp DEL    &trans      &trans  &kp ENTER  &kp SPACE          &trans  &trans  &trans  &trans    &trans
            >;
        };

        CapsWord {
            display-name = "CapsWord";
            bindings = <
&cw_exitkey EQUAL  &kp N1             &kp N2                &kp N3            &kp N4                &kp N5     &trans                                                                                                             &trans             &kp N6     &kp N7                &kp N8             &kp N9            &kp N0            &cw_minus MINUS UNDER
&cw_exitkey TAB    &kp LS(Q)          &kp LS(W)             &kp LS(E)         &kp LS(R)             &kp LS(T)  &trans                                                                                                             &trans             &kp LS(Y)  &kp LS(U)             &kp LS(I)          &kp LS(O)         &kp LS(P)         &cw_exitkey BSLH
&cw_exitkey ESC    &kp LS(A)          &cw_hold_tap S LS(S)  &kp LS(D)         &hrmli_layer 3 LS(F)  &kp LS(G)  &trans              &cw_exitkey LCTRL         &cw_exitkey LALT      &cw_exitkey LGUI   &cw_exitkey RCTRL           &trans             &kp LS(H)  &hrmri_layer 3 LS(J)  &kp LS(K)          &kp LS(L)         &cw_exitkey SEMI  &cw_exitkey SQT
&td_cw_shift       &kp LS(Z)          &kp LS(X)             &kp LS(C)         &kp LS(V)             &kp LS(B)                                                &cw_exitkey HOME      &cw_exitkey PG_UP                                                 &kp LS(N)  &kp LS(M)             &cw_exitkey COMMA  &cw_exitkey DOT   &cw_exitkey FSLH  &td_cw_shift
&none              &cw_exitkey GRAVE  &cw_exitkey CAPS      &cw_exitkey LEFT  &cw_exitkey RIGHT                &cw_bs 4 BACKSPACE  &cw_exitkeyorlayer 5 DEL  &cw_exitkey END       &cw_exitkey PG_DN  &cw_exitkeyorlayer 6 ENTER  &cw_exitkey SPACE             &cw_exitkey UP        &cw_exitkey DOWN   &cw_exitkey LBKT  &cw_exitkey RBKT  &none
            >;
        };

        CapsWordShifted {
            bindings = <
&trans  &cw_exitkey LS(N1)  &cw_exitkey LS(N2)  &cw_exitkey LS(N3)  &cw_exitkey LS(N4)  &cw_exitkey LS(N5)  &trans                                      &trans  &cw_exitkey LS(N6)  &cw_exitkey LS(N7)  &cw_exitkey LS(N8)  &cw_exitkey LS(N9)  &cw_exitkey LS(N0)  &trans
&trans  &trans              &trans              &trans              &trans              &trans              &trans                                      &trans  &trans              &trans              &trans              &trans              &trans              &trans
&trans  &trans              &kp LS(S)           &trans              &kp LS(F)           &trans              &trans  &trans  &trans      &trans  &trans  &trans  &trans              &kp LS(J)           &trans              &trans              &trans              &trans
&trans  &trans              &trans              &trans              &trans              &trans                              &trans      &trans                  &trans              &trans              &trans              &trans              &trans              &trans
&trans  &trans              &trans              &trans              &trans                                  &trans  &trans  &trans      &trans  &trans  &trans                      &trans              &trans              &trans              &trans              &trans
            >;

            label = "CapsWordShifted";
        };

        Navigation {
            bindings = <
&none       &kp LA(LC(F1))  &kp LA(LC(F2))  &kp LA(LC(F3))   &none        &kp F5                 &trans                                  &trans  &kp TILDE  &kp INS            &none         &none       &none           &none
&none       &none           &kp LC(W)       &ctrl_shift_tab  &kp LC(TAB)  &none                  &trans                                  &trans  &kp HOME   &kp PAGE_DOWN      &kp PAGE_UP   &kp END     &thanks_pat     &kp LG(LA(K))
&none       &kp LGUI        &kp LEFT_ALT    &kp LCTRL        &kp LSHFT    &nav_alttab 0 LA(TAB)  &trans  &none  &none      &none  &none  &trans  &kp LEFT   &kp DOWN           &kp UP        &kp RIGHT   &kp GRAVE       &kp LC(PAUSE_BREAK)
&kp LSHIFT  &kp LC(Z)       &kp LC(X)       &kp LC(C)        &kp LC(V)    &browser_copy_url                     &none      &none                 &none      &none              &none         &none       &triple_bquote  &kp RSHIFT
&none       &none           &none           &kp C_PREV       &kp C_NEXT                          &none   &none  &none      &none  &none  &none              &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_MUTE  &none           &none
            >;

            label = "Navigation";
        };

        Function {
            bindings = <
&none  &none     &none     &none      &none      &none  &trans                                  &trans  &none            &none   &none    &none    &none    &none
&none  &none     &none     &none      &none      &none  &trans                                  &trans  &kp PRINTSCREEN  &kp F9  &kp F10  &kp F11  &kp F12  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &trans  &none  &none      &none  &none  &trans  &kp INS          &kp F5  &kp F6   &kp F7   &kp F8   &none
&none  &none     &none     &none      &none      &none                 &none      &none                 &kp PAUSE_BREAK  &kp F1  &kp F2   &kp F3   &kp F4   &none
&none  &none     &none     &none      &none             &none   &none  &none      &none  &none  &none                    &none   &none    &none    &none    &none
            >;

            label = "Function";
        };

        Symbol {
            bindings = <
&none  &none  &none  &none             &none              &none  &trans                                  &trans  &none  &none      &none      &none     &none     &none
&none  &none  &none  &kp LPAR          &kp RPAR           &none  &trans                                  &trans  &none  &none      &none      &none     &none     &none
&none  &none  &none  &kp LEFT_BRACE    &kp RIGHT_BRACE    &none  &trans  &none  &none      &none  &none  &trans  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &none  &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none                 &none      &none                 &none  &none      &none      &none     &none     &none
&none  &none  &none  &none             &none                     &none   &none  &none      &none  &none  &none          &none      &none      &none     &none     &none
            >;

            label = "Symbol";
        };

        System {
            display-name = "System";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                                 &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &to 0         &to 1         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        TabSwitcher {
            bindings = <
&none  &none  &none  &none     &none      &none  &trans                                  &trans  &none     &none     &none     &none      &none  &none
&none  &none  &none  &none     &none      &none  &trans                                  &trans  &kp HOME  &none     &none     &kp END    &none  &none
&none  &none  &none  &none     &none      &none  &trans  &none  &none      &none  &none  &trans  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &none  &none
&none  &none  &none  &none     &none      &none                 &none      &none                 &none     &none     &none     &none      &none  &none
&none  &none  &none  &kp LEFT  &kp RIGHT         &none   &none  &none      &none  &none  &none             &kp UP    &kp DOWN  &none      &none  &none
            >;

            label = "TabSwitcher";
        };

        Mouse {
            bindings = <
&none  &none     &none     &none      &none      &none  &trans                                          &trans  &none           &none           &none           &none            &none            &none
&none  &none     &none     &none      &none      &none  &trans                                          &trans  &none           &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_UP     &none            &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &trans    &tog 9    &none         &none  &none  &trans  &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &none
&none  &none     &none     &none      &none      &none                      &none         &none                 &none           &msc SCRL_DOWN  &none           &msc SCRL_DOWN   &none            &none
&none  &none     &none     &none      &none             &mkp MB1  &mkp MB2  &mkp MB3      &none  &none  &none                   &none           &none           &none            &none            &none
            >;

            label = "Mouse";
        };
    };
};
