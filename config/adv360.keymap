#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmli: hrmli {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        hrmri: hrmri {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMRI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        thumblayer: thumblayer {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMBLAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <2500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            retro-tap;
        };

        td_playpause: td_playpause {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLAYPAUSE";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY_PAUSE>, <&kp LS(C_PLAY_PAUSE)>;
        };
    };

    macros {
        thanks_pat: thanks_pat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none>,
                <&macro_tap_time 2>,
                <&kp LS(T) &kp H &kp A &kp N &kp K &kp S &kp COMMA &kp LS(RET) &kp LS(P) &kp A &kp T>;

            label = "THANKS_PAT";
        };

        triple_bquote: triple_bquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap_time 2>, <&kp GRAVE &kp GRAVE &kp GRAVE>;

            label = "TRIPLE_BQUOTE";
        };

        browser_copy_url: browser_copy_url {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(D) &kp LC(C) &kp ESC &kp TAB>;
            label = "BROWSER_COPY_URL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1        &kp N2        &kp N3         &kp N4           &kp N5  &mo 4                                                                                        &mo 4          &kp N6  &kp N7           &kp N8         &kp N9             &kp N0                &kp MINUS
&kp TAB    &kp Q         &kp W         &kp E          &kp R            &kp T   &none                                                                                        &none          &kp Y   &kp U            &kp I          &kp O              &kp P                 &kp BSLH
&kp ESC    &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &hrmli LSHIFT F  &kp G   &kp C_MUTE               &kp LCTRL             &kp LALT      &kp LGUI   &kp RCTRL            &td_playpause  &kp H   &hrmri RSHIFT J  &hrmr RCTRL K  &hrmr RIGHT_ALT L  &hrmr RGUI SEMICOLON  &kp SQT
&kp LSHFT  &kp Z         &kp X         &kp C          &kp V            &kp B                                                  &kp HOME      &kp PG_UP                                      &kp N   &kp M            &kp COMMA      &kp DOT            &kp FSLH              &kp RSHFT
&none      &kp GRAVE     &kp CAPS      &kp LEFT       &kp RIGHT                &thumblayer 1 BACKSPACE  &thumblayer 2 DELETE  &kp END       &kp PG_DN  &thumblayer 3 ENTER  &kp SPACE              &kp UP           &kp DOWN       &kp LBKT           &kp RBKT              &none
            >;
        };

        Navigation {
            bindings = <
&none       &kp LA(LC(F1))  &kp LA(LC(F2))  &kp LA(LC(F3))   &none        &none              &trans                                  &trans  &kp TILDE  &kp INS            &none         &none       &none           &none
&none       &none           &kp LC(W)       &kp LC(LS(TAB))  &kp LC(TAB)  &none              &trans                                  &trans  &kp HOME   &kp PAGE_DOWN      &kp PAGE_UP   &kp END     &thanks_pat     &kp LG(LA(K))
&none       &kp LGUI        &kp LEFT_ALT    &kp LCTRL        &kp LSHFT    &kp LA(TAB)        &trans  &none  &none      &none  &none  &trans  &kp LEFT   &kp DOWN           &kp UP        &kp RIGHT   &kp GRAVE       &kp LC(PAUSE_BREAK)
&kp LSHIFT  &kp LC(Z)       &kp LC(X)       &kp LC(C)        &kp LC(V)    &browser_copy_url                 &none      &none                 &none      &none              &none         &none       &triple_bquote  &kp RSHIFT
&none       &none           &none           &kp C_PREV       &kp C_NEXT                      &none   &none  &none      &none  &none  &none              &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_MUTE  &none           &none
            >;
        };

        Function {
            bindings = <
&none  &none     &none     &none      &none      &none  &trans                                  &trans  &none            &none   &none    &none    &none    &none
&none  &none     &none     &none      &none      &none  &trans                                  &trans  &kp PRINTSCREEN  &kp F9  &kp F10  &kp F11  &kp F12  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &trans  &none  &none      &none  &none  &trans  &kp INS          &kp F5  &kp F6   &kp F7   &kp F8   &none
&none  &none     &none     &none      &none      &none                 &none      &none                 &kp PAUSE_BREAK  &kp F1  &kp F2   &kp F3   &kp F4   &none
&none  &none     &none     &none      &none             &none   &none  &none      &none  &none  &none                    &none   &none    &none    &none    &none
            >;
        };

        Symbol {
            bindings = <
&none  &none  &none  &none             &none              &none  &trans                                  &trans  &none  &none      &none      &none     &none     &none
&none  &none  &none  &kp LPAR          &kp RPAR           &none  &trans                                  &trans  &none  &none      &none      &none     &none     &none
&none  &none  &none  &kp LEFT_BRACE    &kp RIGHT_BRACE    &none  &trans  &none  &none      &none  &none  &trans  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &none  &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none                 &none      &none                 &none  &none      &none      &none     &none     &none
&none  &none  &none  &none             &none                     &none   &none  &none      &none  &none  &none          &none      &none      &none     &none     &none
            >;
        };

        mod {
            display-name = "System";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
