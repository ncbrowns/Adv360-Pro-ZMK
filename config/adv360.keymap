#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmli: hrmli {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        hrmri: hrmri {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMRI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        thumblayer: thumblayer {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMBLAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <2500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            retro-tap;
        };

        td_playpause: td_playpause {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLAYPAUSE";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY_PAUSE>, <&kp LS(C_PLAY_PAUSE)>;
        };

        td_shift_cw: td_shift_cw {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT_CW";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&tog 1>;
        };

        cw_hold_tap: cw_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CW_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        cw_underscrore: cw_underscrore {
            compatible = "zmk,behavior-hold-tap";
            label = "CW_UNDERSCRORE";
            bindings = <&cw_exitkey>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        nav_alttab: nav_alttab {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_ALTTAB";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            bindings = <&at_enter>, <&kp>;
        };

        hrmli_layer: hrmli_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLI_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 37 38 53 68 69 70>;
        };

        hrmri_layer: hrmri_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMRI_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        thumblayer_cw_continue: thumblayer_cw_continue {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMBLAYER_CW_CONTINUE";
            bindings = <&mo>, <&cw_tap_continue>;

            #binding-cells = <2>;
            tapping-term-ms = <2500>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <250>;
            retro-tap;
        };
    };

    macros {
        thanks_pat: thanks_pat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none>,
                <&macro_tap_time 2>,
                <&kp LS(T) &kp H &kp A &kp N &kp K &kp S &kp COMMA &kp LS(RET) &kp LS(P) &kp A &kp T>;

            label = "THANKS_PAT";
        };

        triple_bquote: triple_bquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap_time 2>, <&kp GRAVE &kp GRAVE &kp GRAVE>;

            label = "TRIPLE_BQUOTE";
        };

        browser_copy_url: browser_copy_url {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(D) &kp LC(C) &kp ESC &kp TAB>;
            label = "BROWSER_COPY_URL";
        };

        cw_exitkey: cw_exitkey {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "CW_EXITKEY";
        };

        at_exit: ts_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 7>, <&macro_release>, <&kp LALT>;

            label = "TS_EXIT";
        };

        at_enter: at_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog 7>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp TAB>;

            label = "AT_ENTER";
        };

        cw_key_delete: cw_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 1 &thumblayer 4 DEL>;
            label = "CW_DELETE";
        };

        cw_key_enter: cw_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 1 &thumblayer 5 ENTER>;
            label = "CW_ENTER";
        };

        cw_key_bs: cw_backspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 1 &thumblayer_cw_continue 3 BACKSPACE>;
            label = "CW_BACKSPACE";
        };

        cw_tap_continue: cw_tap_continue {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "CW_TAP_CONTINUE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL     &kp N1        &kp N2        &kp N3         &kp N4           &kp N5  &mo 6                                                                                        &mo 6          &kp N6  &kp N7           &kp N8         &kp N9             &kp N0                &kp MINUS
&kp TAB       &kp Q         &kp W         &kp E          &kp R            &kp T   &none                                                                                        &none          &kp Y   &kp U            &kp I          &kp O              &kp P                 &kp BSLH
&kp ESC       &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &hrmli LSHIFT F  &kp G   &kp C_MUTE               &kp LCTRL             &kp LALT      &kp LGUI   &kp RCTRL            &td_playpause  &kp H   &hrmri RSHIFT J  &hrmr RCTRL K  &hrmr RIGHT_ALT L  &hrmr RGUI SEMICOLON  &kp SQT
&td_shift_cw  &kp Z         &kp X         &kp C          &kp V            &kp B                                                  &kp HOME      &kp PG_UP                                      &kp N   &kp M            &kp COMMA      &kp DOT            &kp FSLH              &td_shift_cw
&none         &kp GRAVE     &kp CAPS      &kp LEFT       &kp RIGHT                &thumblayer 3 BACKSPACE  &thumblayer 4 DELETE  &kp END       &kp PG_DN  &thumblayer 5 ENTER  &kp SPACE              &kp UP           &kp DOWN       &kp LBKT           &kp RBKT              &none
            >;
        };

        CapsWord {
            display-name = "Base";
            bindings = <
&cw_exitkey EQUAL  &kp N1             &kp N2                &kp N3            &kp N4                &kp N5     &trans                                                                                     &trans             &kp N6     &kp N7                &kp N8             &kp N9            &kp N0            &cw_underscrore MINUS UNDER
&cw_exitkey TAB    &kp LS(Q)          &kp LS(W)             &kp LS(E)         &kp LS(R)             &kp LS(T)  &trans                                                                                     &trans             &kp LS(Y)  &kp LS(U)             &kp LS(I)          &kp LS(O)         &kp LS(P)         &cw_exitkey BSLH
&cw_exitkey ESC    &kp LS(A)          &cw_hold_tap S LS(S)  &kp LS(D)         &hrmli_layer 2 LS(F)  &kp LS(G)  &trans      &cw_exitkey LCTRL  &cw_exitkey LALT      &cw_exitkey LGUI   &cw_exitkey RCTRL  &trans             &kp LS(H)  &hrmri_layer 2 LS(J)  &kp LS(K)          &kp LS(L)         &cw_exitkey SEMI  &cw_exitkey SQT
&mo 2              &kp LS(Z)          &kp LS(X)             &kp LS(C)         &kp LS(V)             &kp LS(B)                                 &cw_exitkey HOME      &cw_exitkey PG_UP                                        &kp LS(N)  &kp LS(M)             &cw_exitkey COMMA  &cw_exitkey DOT   &cw_exitkey FSLH  &mo 2
&none              &cw_exitkey GRAVE  &cw_exitkey CAPS      &cw_exitkey LEFT  &cw_exitkey RIGHT                &cw_key_bs  &cw_key_delete     &cw_exitkey END       &cw_exitkey PG_DN  &cw_key_enter      &cw_exitkey SPACE             &cw_exitkey UP        &cw_exitkey DOWN   &cw_exitkey LBKT  &cw_exitkey RBKT  &none
            >;
        };

        CapsWordShifted {
            bindings = <
&trans  &cw_exitkey LS(N1)  &cw_exitkey LS(N2)  &cw_exitkey LS(N3)  &cw_exitkey LS(N4)  &cw_exitkey LS(N5)  &trans                                      &trans  &cw_exitkey LS(N6)  &cw_exitkey LS(N7)  &cw_exitkey LS(N8)  &cw_exitkey LS(N9)  &cw_exitkey LS(N0)  &trans
&trans  &trans              &trans              &trans              &trans              &trans              &trans                                      &trans  &trans              &trans              &trans              &trans              &trans              &trans
&trans  &trans              &kp LS(S)           &trans              &kp LS(F)           &trans              &trans  &trans  &trans      &trans  &trans  &trans  &trans              &kp LS(J)           &trans              &trans              &trans              &trans
&trans  &trans              &trans              &trans              &trans              &trans                              &trans      &trans                  &trans              &trans              &trans              &trans              &trans              &trans
&trans  &trans              &trans              &trans              &trans                                  &trans  &trans  &trans      &trans  &trans  &trans                      &trans              &trans              &trans              &trans              &trans
            >;
        };

        Navigation {
            bindings = <
&none       &kp LA(LC(F1))  &kp LA(LC(F2))  &kp LA(LC(F3))   &none        &none                  &trans                                  &trans  &kp TILDE  &kp INS            &none         &none       &none           &none
&none       &none           &kp LC(W)       &kp LC(LS(TAB))  &kp LC(TAB)  &none                  &trans                                  &trans  &kp HOME   &kp PAGE_DOWN      &kp PAGE_UP   &kp END     &thanks_pat     &kp LG(LA(K))
&none       &kp LGUI        &kp LEFT_ALT    &kp LCTRL        &kp LSHFT    &nav_alttab 0 LA(TAB)  &trans  &none  &none      &none  &none  &trans  &kp LEFT   &kp DOWN           &kp UP        &kp RIGHT   &kp GRAVE       &kp LC(PAUSE_BREAK)
&kp LSHIFT  &kp LC(Z)       &kp LC(X)       &kp LC(C)        &kp LC(V)    &browser_copy_url                     &none      &none                 &none      &none              &none         &none       &triple_bquote  &kp RSHIFT
&none       &none           &none           &kp C_PREV       &kp C_NEXT                          &none   &none  &none      &none  &none  &none              &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_MUTE  &none           &none
            >;
        };

        Function {
            bindings = <
&none  &none     &none     &none      &none      &none  &trans                                  &trans  &none            &none   &none    &none    &none    &none
&none  &none     &none     &none      &none      &none  &trans                                  &trans  &kp PRINTSCREEN  &kp F9  &kp F10  &kp F11  &kp F12  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &trans  &none  &none      &none  &none  &trans  &kp INS          &kp F5  &kp F6   &kp F7   &kp F8   &none
&none  &none     &none     &none      &none      &none                 &none      &none                 &kp PAUSE_BREAK  &kp F1  &kp F2   &kp F3   &kp F4   &none
&none  &none     &none     &none      &none             &none   &none  &none      &none  &none  &none                    &none   &none    &none    &none    &none
            >;
        };

        Symbol {
            bindings = <
&none  &none  &none  &none             &none              &none  &trans                                  &trans  &none  &none      &none      &none     &none     &none
&none  &none  &none  &kp LPAR          &kp RPAR           &none  &trans                                  &trans  &none  &none      &none      &none     &none     &none
&none  &none  &none  &kp LEFT_BRACE    &kp RIGHT_BRACE    &none  &trans  &none  &none      &none  &none  &trans  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &none  &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none                 &none      &none                 &none  &none      &none      &none     &none     &none
&none  &none  &none  &none             &none                     &none   &none  &none      &none  &none  &none          &none      &none      &none     &none     &none
            >;
        };

        System {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        TabSwitcher {
            bindings = <
&none     &none  &none  &none     &none      &none  &none                                           &none     &none     &none     &none     &none      &none  &none
&none     &none  &none  &none     &none      &none  &none                                           &none     &kp HOME  &none     &none     &kp END    &none  &none
&at_exit  &none  &none  &none     &none      &none  &none     &none     &none      &none  &none     &none     &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &none  &none
&none     &none  &none  &none     &none      &none                      &none      &none                      &none     &none     &none     &none      &none  &none
&none     &none  &none  &kp LEFT  &kp RIGHT         &at_exit  &at_exit  &none      &none  &at_exit  &at_exit            &kp UP    &kp DOWN  &none      &none  &none
            >;
        };
    };
};
